# Copy to .env.local. Never commit secrets.
# Explicitly choose fixture, waffo-test, or waffo-prod. Do not infer a mode.
PAYMENT_MODE=fixture
WAFFO_MODE=
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_API_BASE=https://api.waffo.ai
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/city-weekend-spot.sqlite
WAFFO_WEBHOOK_PUBLIC_KEY=
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=

# Waffo Pancake is the sole merchant of record. Legacy provider variables are ignored.
